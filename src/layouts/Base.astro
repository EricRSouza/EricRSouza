---
import '../styles/global.css';
import { htmlLang, path, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Root-relative URL of this page in the other language, when one exists. */
  alternate?: string;
  /** Marks the matching nav item as the current page. */
  current?: 'home' | 'about';
  ogType?: 'website' | 'article';
}

const { lang, title, description = ui[lang].siteDescription, alternate, current, ogType = 'website' } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'pt' : 'en';
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Eric Ramos Souza' ? title : `${title} | Eric Ramos Souza`;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={htmlLang[other]} href={new URL(alternate, Astro.site)} />}
    <link rel="alternate" hreflang={htmlLang[lang]} href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Eric Ramos Souza" href={path(lang, '/rss.xml')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    <meta name="theme-color" content="#f5f7f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14152b" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <header class="wrap site-header sans">
      <a class="brand" href={path(lang)} aria-current={current === 'home' ? 'page' : undefined}>Eric Ramos Souza</a>
      <nav aria-label={lang === 'en' ? 'Main' : 'Principal'}>
        <a href={path(lang, '/about/')} aria-current={current === 'about' ? 'page' : undefined}>{t.navAbout}</a>
        <a href={alternate ?? path(other)} hreflang={htmlLang[other]} lang={htmlLang[other]} title={t.switchLangLabel}>{t.switchLang}</a>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap sans">
      <div class="site-footer">
        <p class="muted">{t.footer}</p>
        <p>
          <a href="https://www.linkedin.com/in/ericramossouzadataanalyst/" rel="me">LinkedIn</a>
          <a href="https://github.com/EricRSouza" rel="me">GitHub</a>
          <a href={path(lang, '/rss.xml')}>RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 0;
    font-size: 1rem;
  }

  .brand {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  main {
    padding-block: clamp(2.5rem, 8vw, 5rem);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a + a {
    margin-left: 1rem;
  }
</style>
