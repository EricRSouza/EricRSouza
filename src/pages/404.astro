---
import Base from '../layouts/Base.astro';
import { Arrow } from '../react/Icons';
import { ui } from '../i18n';
---

<Base lang="en" title="404">
  <section
    class="container section listing-page not-found"
    data-pt-title={ui.pt.notFoundTitle}
    data-pt-text={ui.pt.notFoundText}
    data-pt-home="Voltar ao início"
    data-pt-lab="Explorar o lab"
  >
    <p class="eyebrow">404</p>
    <h1 data-nf-title>{ui.en.notFoundTitle}</h1>
    <p class="page-description" data-nf-text>{ui.en.notFoundText}</p>
    <p class="page-description" lang="pt-BR" data-nf-alt>{ui.pt.notFoundTitle} {ui.pt.notFoundText}</p>
    <div class="hero-actions">
      <a class="button" href="/" data-nf-primary>Home<Arrow /></a>
      <a class="text-link" href="/pt/" data-nf-secondary>Início em português<Arrow /></a>
    </div>
  </section>
</Base>

<script>
  // Adapt 404 copy and navigation links to Portuguese when the missing path is under `/pt/`.
  if (location.pathname === '/pt' || location.pathname.startsWith('/pt/')) {
    const root = document.querySelector<HTMLElement>('.not-found');
    if (root) {
      document.documentElement.lang = 'pt-BR';
      const titleEl = root.querySelector<HTMLElement>('[data-nf-title]');
      const textEl = root.querySelector<HTMLElement>('[data-nf-text]');
      const altEl = root.querySelector<HTMLElement>('[data-nf-alt]');
      const primary = root.querySelector<HTMLAnchorElement>('[data-nf-primary]');
      const secondary = root.querySelector<HTMLAnchorElement>('[data-nf-secondary]');
      if (titleEl && root.dataset.ptTitle) titleEl.textContent = root.dataset.ptTitle;
      if (textEl && root.dataset.ptText) textEl.textContent = root.dataset.ptText;
      if (altEl) altEl.hidden = true;
      if (primary) {
        primary.href = '/pt/';
        if (primary.firstChild) primary.firstChild.textContent = root.dataset.ptHome ?? 'Voltar ao início';
      }
      if (secondary) {
        secondary.href = '/pt/blog/';
        if (secondary.firstChild) secondary.firstChild.textContent = root.dataset.ptLab ?? 'Explorar o lab';
      }
    }
  }
</script>
