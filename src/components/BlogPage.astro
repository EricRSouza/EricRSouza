---
/**
 * The unified feed, labelled "Lab" (`/blog/`, `/pt/blog/`): projects, articles and notes in one list, filterable by type and tag.
 * The "Projects" nav item is just this page with `?type=project`.
 * Filters are plain links (`?type=project`, `?tag=power-bi`) so they work without JS and can be shared;
 * the script applies them in place.
 */
import Base from '../layouts/Base.astro';
import { Arrow } from '../react/Icons';
import { postTypes } from '../content.config';
import { formatDate, path, ui, type Lang } from '../i18n';
import { getPosts, postUrl, tagKey } from '../posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const usedTypes = postTypes.filter((type) => posts.some((p) => p.data.type === type));
const tags = [...new Map(posts.flatMap((p) => p.data.tags).map((tag) => [tagKey(tag), tag])).entries()].sort((a, b) =>
  a[1].localeCompare(b[1]),
);
const blog = path(lang, '/blog/');
---

<Base lang={lang} title={t.nav.blog} description={t.blogIntro} alternate={path(lang === 'en' ? 'pt' : 'en', '/blog/')} current="blog">
  <section class="section listing-page container feed" data-lang={lang} data-count-one={t.resultsCount(1)} data-count-many={t.resultsCount(0).replace('0', '{n}')}>
    <p class="eyebrow">{t.blogLabel}</p>
    <h1 data-feed-heading data-default-title={t.blogTitle} data-projects-title={t.projectsTitle}>{t.blogTitle}</h1>
    <p class="page-description">{t.blogIntro}</p>

    <div class="filters">
      <div class="filter-row">
        <span class="filter-group-label" id="filter-type-label">{t.filterGroupType}</span>
        <ul class="chips" aria-labelledby="filter-type-label">
          <li><a href={blog} data-filter="type" data-value="" data-track="feed_filter" data-track-filter-type="type" data-track-filter-value="all" aria-current="true">{t.filterAll}</a></li>
          {
            usedTypes.map((type) => (
              <li>
                <a href={`${blog}?type=${type}`} data-filter="type" data-value={type} data-track="feed_filter" data-track-filter-type="type" data-track-filter-value={type}>
                  {t.typesPlural[type]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        tags.length > 0 && (
          <div class="filter-row" data-tag-row>
            <span class="filter-group-label" id="filter-topic-label">{t.filterGroupTopic}</span>
            <ul class="chips tags" aria-labelledby="filter-topic-label">
              {tags.map(([key, label]) => (
                <li>
                  <a href={`${blog}?tag=${key}`} data-filter="tag" data-value={key} data-track="feed_filter" data-track-filter-type="tag" data-track-filter-value={key}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="sr-only" role="status" aria-live="polite" data-feed-status></p>
    </div>

    <div class="blog-list">
      {
        posts.map((post) => (
          <article data-type={post.data.type} data-tags={post.data.tags.map(tagKey).join(' ')}>
            <span class="article-type">{t.types[post.data.type]}</span>
            <div>
              <div class="article-meta">
                <span>{post.data.kicker}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
              </div>
              <h2>
                <a href={postUrl(post)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <a class="text-link" href={postUrl(post)} aria-label={`${t.read}: ${post.data.title}`}>
                {t.read}
                <Arrow />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="feed-empty" role="status" aria-live="polite" hidden>{t.emptyFeed} <a class="text-link" href={blog}>{t.clearFilters}</a></p>
  </section>
</Base>

<script>
  // Applies ?type= and ?tag= from the URL to the list, hides incompatible tags, and keeps chip clicks in-page.
  function apply(announce = false) {
    const feed = document.querySelector<HTMLElement>('.feed');
    if (!feed) return;
    const params = new URLSearchParams(location.search);
    const type = params.get('type') ?? '';
    const tag = params.get('tag') ?? '';
    const articles = [...feed.querySelectorAll<HTMLElement>('.blog-list > article')];
    let visible = 0;

    for (const item of articles) {
      const show =
        (!type || item.dataset.type === type) && (!tag || (item.dataset.tags ?? '').split(' ').includes(tag));
      item.hidden = !show;
      if (show) visible++;
    }

    // Hide topic tags that have zero matching posts under the active type filter (prevents empty dead ends).
    const availableTags = new Set<string>();
    for (const item of articles) {
      if (!type || item.dataset.type === type) {
        for (const t of (item.dataset.tags ?? '').split(' ').filter(Boolean)) availableTags.add(t);
      }
    }
    let visibleTagChips = 0;
    for (const chip of feed.querySelectorAll<HTMLAnchorElement>('[data-filter="tag"]')) {
      const val = chip.dataset.value ?? '';
      const allowed = availableTags.has(val) || val === tag;
      const li = chip.closest('li');
      if (li) li.hidden = !allowed;
      if (allowed) visibleTagChips++;
    }
    const tagRow = feed.querySelector<HTMLElement>('[data-tag-row]');
    if (tagRow) tagRow.hidden = visibleTagChips === 0;

    for (const chip of feed.querySelectorAll<HTMLAnchorElement>('[data-filter]')) {
      const active = chip.dataset.filter === 'type' ? type : tag;
      const current = chip.dataset.value === active && (chip.dataset.value !== '' || !tag);
      if (current) chip.setAttribute('aria-current', 'true');
      else chip.removeAttribute('aria-current');
    }

    // Update H1 and nav active state (desktop + mobile) when viewing Projects vs Lab.
    const heading = feed.querySelector<HTMLElement>('[data-feed-heading]');
    if (heading) {
      heading.textContent = type === 'project' ? (heading.dataset.projectsTitle ?? heading.textContent) : (heading.dataset.defaultTitle ?? heading.textContent);
    }
    const section = type === 'project' ? 'projects' : 'blog';
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.site-header [data-nav="projects"], .site-header [data-nav="blog"]')) {
      if (link.dataset.nav === section) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }

    const empty = feed.querySelector<HTMLElement>('.feed-empty');
    if (empty) empty.hidden = visible > 0;

    const status = feed.querySelector<HTMLElement>('[data-feed-status]');
    if (status && announce) {
      const one = feed.dataset.countOne ?? '1';
      const many = (feed.dataset.countMany ?? '{n}').replace('{n}', String(visible));
      status.textContent = visible === 1 ? one : many;
    }
  }

  document.querySelector('.feed .filters')?.addEventListener('click', (event) => {
    const chip = (event.target as Element).closest<HTMLAnchorElement>('[data-filter]');
    if (!chip) return;
    event.preventDefault();
    const params = new URLSearchParams(location.search);
    const { filter, value } = chip.dataset;
    if (!filter || !value) {
      params.delete('type');
      params.delete('tag');
    } else if (params.get(filter) === value) {
      params.delete(filter);
    } else {
      params.set(filter, value);
      // When switching type, drop any tag that no longer matches that type.
      if (filter === 'type') {
        const currentTag = params.get('tag');
        if (currentTag) {
          const matches = [...document.querySelectorAll<HTMLElement>('.feed .blog-list > article')].some(
            (item) => item.dataset.type === value && (item.dataset.tags ?? '').split(' ').includes(currentTag),
          );
          if (!matches) params.delete('tag');
        }
      }
    }
    const query = params.toString();
    history.pushState(null, '', query ? `?${query}` : location.pathname);
    apply(true);
  });

  window.addEventListener('popstate', () => apply(true));
  apply(false);
</script>
