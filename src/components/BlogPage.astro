---
/**
 * The unified feed (`/blog/`, `/pt/blog/`): projects, articles and notes in one list, filterable by type and tag.
 * Filters are plain links (`?type=project`, `?tag=power-bi`) so they work without JS and can be shared;
 * the script applies them in place.
 */
import Base from '../layouts/Base.astro';
import { Arrow } from '../react/Icons';
import { postTypes } from '../content.config';
import { formatDate, path, ui, type Lang } from '../i18n';
import { getPosts, postUrl, tagKey } from '../posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const usedTypes = postTypes.filter((type) => posts.some((p) => p.data.type === type));
const tags = [...new Map(posts.flatMap((p) => p.data.tags).map((tag) => [tagKey(tag), tag])).entries()].sort((a, b) =>
  a[1].localeCompare(b[1]),
);
const blog = path(lang, '/blog/');
---

<Base lang={lang} title="Blog" description={t.blogIntro} alternate={path(lang === 'en' ? 'pt' : 'en', '/blog/')} current="blog">
  <section class="section listing-page container feed">
    <p class="eyebrow">{t.blogLabel}</p>
    <h1>{t.blogTitle}</h1>
    <p class="page-description">{t.blogIntro}</p>

    <div class="filters">
      <ul class="chips" aria-label={t.filterLabel}>
        <li><a href={blog} data-filter="type" data-value="" aria-current="true">{t.filterAll}</a></li>
        {
          usedTypes.map((type) => (
            <li>
              <a href={`${blog}?type=${type}`} data-filter="type" data-value={type}>
                {t.typesPlural[type]}
              </a>
            </li>
          ))
        }
      </ul>
      {
        tags.length > 0 && (
          <ul class="chips tags" aria-label={t.tagLabel}>
            {tags.map(([key, label]) => (
              <li>
                <a href={`${blog}?tag=${key}`} data-filter="tag" data-value={key}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="blog-list">
      {
        posts.map((post) => (
          <article data-type={post.data.type} data-tags={post.data.tags.map(tagKey).join(' ')}>
            <span class="article-type">{t.types[post.data.type]}</span>
            <div>
              <div class="article-meta">
                <span>{post.data.kicker}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <h2>
                <a href={postUrl(post)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <a class="text-link" href={postUrl(post)}>
                {t.read}
                <Arrow />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="feed-empty" hidden>{t.emptyFeed} <a class="text-link" href={blog}>{t.clearFilters}</a></p>
  </section>
</Base>

<script>
  // Applies ?type= and ?tag= from the URL to the list, and keeps chip clicks in-page.
  function apply() {
    const params = new URLSearchParams(location.search);
    const type = params.get('type') ?? '';
    const tag = params.get('tag') ?? '';
    let visible = 0;

    for (const item of document.querySelectorAll<HTMLElement>('.feed .blog-list > article')) {
      const show =
        (!type || item.dataset.type === type) && (!tag || (item.dataset.tags ?? '').split(' ').includes(tag));
      item.hidden = !show;
      if (show) visible++;
    }

    for (const chip of document.querySelectorAll<HTMLAnchorElement>('.feed [data-filter]')) {
      const active = chip.dataset.filter === 'type' ? type : tag;
      const current = chip.dataset.value === active && (chip.dataset.value !== '' || !tag);
      if (current) chip.setAttribute('aria-current', 'true');
      else chip.removeAttribute('aria-current');
    }

    const empty = document.querySelector<HTMLElement>('.feed .feed-empty');
    if (empty) empty.hidden = visible > 0;
  }

  document.querySelector('.feed .filters')?.addEventListener('click', (event) => {
    const chip = (event.target as Element).closest<HTMLAnchorElement>('[data-filter]');
    if (!chip) return;
    event.preventDefault();
    const params = new URLSearchParams(location.search);
    const { filter, value } = chip.dataset;
    if (!filter || !value) {
      params.delete('type');
      params.delete('tag');
    } else if (params.get(filter) === value) {
      params.delete(filter);
    } else {
      params.set(filter, value);
    }
    const query = params.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
    apply();
  });

  apply();
</script>
