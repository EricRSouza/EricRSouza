---
/** Article layout for every post type, in either language. */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, path, ui } from '../i18n';
import { postUrl, tagKey, type Post } from '../posts';

interface Props {
  post: Post;
  translation?: Post;
}

const { post, translation } = Astro.props;
const { lang } = post;
const t = ui[lang];
const { Content } = await render(post);
const { title, description, date, updated, type, tags } = post.data;
---

<Base
  lang={lang}
  title={title}
  description={description}
  alternate={translation ? postUrl(translation) : undefined}
  ogType="article"
>
  <article>
    <header class="post-header">
      <p class="kind sans" data-type={type}>
        <span class="swatch" aria-hidden="true"></span>
        {t.types[type]}
      </p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <p class="meta sans muted">
        <span>{t.published} <time datetime={date.toISOString()}>{formatDate(lang, date)}</time></span>
        {
          updated && (
            <span>
              {t.updatedOn} <time datetime={updated.toISOString()}>{formatDate(lang, updated)}</time>
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags sans">
            {tags.map((tag) => (
              <li>
                <a href={`${path(lang)}?tag=${tagKey(tag)}`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      {!translation && <p class="sans muted note">{ui[lang === 'en' ? 'pt' : 'en'].noTranslation}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back sans"><a href={path(lang)}>{t.backHome}</a></p>
</Base>

<style>
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.1rem, 6vw, 3.2rem);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.05;
  }

  .dek {
    margin: 1rem 0 0;
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .tags a {
    display: inline-block;
    padding: 0.2em 0.65em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .tags a:hover {
    border-color: var(--muted);
    color: var(--ink);
  }

  .note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .back {
    margin-top: 4rem;
    font-size: 1rem;
  }
</style>
