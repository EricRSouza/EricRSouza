---
/**
 * Page for one post, in either language. Projects use the case-study layout (media, "at a glance", body);
 * articles and notes use the long-form reading layout.
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PowerBIEmbed from './mdx/PowerBIEmbed.astro';
import Note from './mdx/Note.astro';
import { Arrow } from '../react/Icons';
import { RevenueChart } from '../react/RevenueChart';
import { formatDate, path, ui } from '../i18n';
import { postUrl, type Post } from '../posts';

interface Props {
  post: Post;
  translation?: Post;
}

const { post, translation } = Astro.props;
const { lang } = post;
const t = ui[lang];
const { Content } = await render(post);
const { title, description, date, kicker, media, glance, type } = post.data;
const project = type === 'project';
const back = project
  ? { href: `${path(lang, '/blog/')}?type=project`, label: t.typesPlural.project }
  : { href: path(lang, '/blog/'), label: 'Blog' };
const missingTranslation = ui[lang === 'en' ? 'pt' : 'en'].noTranslation;
---

<Base lang={lang} title={title} description={description} alternate={translation && postUrl(translation)} current={project ? 'projects' : 'blog'} ogType="article">
  {
    project ? (
      <article class="project-page container">
        <header class="project-header">
          <a class="back-link" href={back.href}>← {t.back} / {back.label}</a>
          <p class="eyebrow">{kicker}</p>
          <h1>{title}</h1>
          <p class="page-description">{description}</p>
          {!translation && <p class="translation-note">{missingTranslation}</p>}
        </header>
        {media?.kind === 'revenue-explorer' && <RevenueChart client:visible locale={lang} />}
        {media?.kind === 'powerbi' && <PowerBIEmbed src={media.src} title={title} lang={lang} />}
        <div class="case-grid">
          <aside>
            <p class="tiny-label">{t.glance}</p>
            <dl>
              {glance.map(([term, value]) => (
                <>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </>
              ))}
              <dt>{lang === 'pt' ? 'Publicado' : 'Published'}</dt>
              <dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
            </dl>
          </aside>
          <div class="case-body">
            <Content components={{ Note }} />
          </div>
        </div>
      </article>
    ) : (
      <article class="article-page">
        <header class="container article-header">
          <a class="back-link" href={back.href}>← {t.back} / {back.label}</a>
          <p class="eyebrow">{kicker}</p>
          <h1>{title}</h1>
          <p class="page-description">{description}</p>
          <div class="author-line">
            <span class="author-avatar">ER</span>
            <span>Eric Ramos Souza</span>
            <span>·</span>
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
          </div>
          {!translation && <p class="translation-note">{missingTranslation}</p>}
        </header>
        {media && (
          <div class="container article-chart">
            {media.kind === 'revenue-explorer' && <RevenueChart client:visible locale={lang} />}
            {media.kind === 'powerbi' && <PowerBIEmbed src={media.src} title={title} lang={lang} />}
          </div>
        )}
        <div class="prose">
          <Content components={{ Note }} />
        </div>
        <div class="container article-end">
          <a class="text-link" href={path(lang, '/blog/')}>
            {t.allArticles}
            <Arrow />
          </a>
        </div>
      </article>
    )
  }
</Base>
