---
/**
 * Embeds a Power BI "Publish to web" report in a post.
 * The iframe loads only after the reader clicks, so the page stays fast.
 *
 * <PowerBIEmbed src="https://app.powerbi.com/view?r=..." title="Cross-sell dashboard" />
 */
interface Props {
  src: string;
  title: string;
  /** Text on the load button. */
  label?: string;
}

const { src, title, label = 'Load the interactive report' } = Astro.props;
---

<figure class="pbi">
  <div class="frame" data-src={src} data-title={title}>
    <button type="button" class="sans">{label}</button>
  </div>
  <figcaption class="sans muted">
    {title} · <a href={src} target="_blank" rel="noopener">Power BI</a>
  </figcaption>
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('.pbi .frame')) {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.src ?? '';
      iframe.title = frame.dataset.title ?? 'Power BI report';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  }
</script>

<style>
  .pbi {
    margin-inline: 0;
  }

  .frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background:
      repeating-linear-gradient(90deg, transparent 0 39px, color-mix(in srgb, var(--rule) 60%, transparent) 39px 40px),
      var(--surface);
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  button {
    padding: 0.7em 1.2em;
    border: 0;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }
</style>
