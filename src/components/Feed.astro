---
/**
 * The unified content feed: every post type in one list, filterable by type and tag.
 * Filters are plain links (`?type=case`, `?tag=power-bi`) so they work without JS and can be shared;
 * the script below applies them in place.
 */
import { postTypes } from '../content.config';
import { formatDate, path, ui, type Lang } from '../i18n';
import { postUrl, tagKey, type Post } from '../posts';

interface Props {
  lang: Lang;
  posts: Post[];
}

const { lang, posts } = Astro.props;
const t = ui[lang];
const usedTypes = postTypes.filter((type) => posts.some((p) => p.data.type === type));
const tags = [...new Map(posts.flatMap((p) => p.data.tags).map((tag) => [tagKey(tag), tag])).entries()].sort((a, b) =>
  a[1].localeCompare(b[1]),
);
const home = path(lang);
---

<section class="feed" aria-labelledby="feed-title">
  <h2 id="feed-title" class="visually-hidden">{t.latest}</h2>

  <div class="filters sans">
    <ul class="chips" aria-label={t.filterLabel}>
      <li><a href={home} data-filter="type" data-value="" aria-current="true">{t.filterAll}</a></li>
      {
        usedTypes.map((type) => (
          <li>
            <a href={`${home}?type=${type}`} data-filter="type" data-value={type} data-type={type}>
              <span class="swatch" aria-hidden="true" />
              {t.typesPlural[type]}
            </a>
          </li>
        ))
      }
    </ul>
    {
      tags.length > 0 && (
        <ul class="chips tags" aria-label={t.tagLabel}>
          {tags.map(([key, label]) => (
            <li>
              <a href={`${home}?tag=${key}`} data-filter="tag" data-value={key}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <ol class="list">
    {
      posts.map((post) => (
        <li data-type={post.data.type} data-tags={post.data.tags.map(tagKey).join(' ')}>
          <span class="kind sans">
            <span class="swatch" aria-hidden="true" />
            {t.types[post.data.type]}
          </span>
          <div>
            <h3>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h3>
            <p class="muted">{post.data.description}</p>
          </div>
          <time class="sans muted" datetime={post.data.date.toISOString()}>
            {formatDate(lang, post.data.date)}
          </time>
        </li>
      ))
    }
  </ol>
  <p class="empty muted" hidden>
    {t.emptyFeed} <a href={home}>{t.clearFilters}</a>
  </p>
</section>

<script>
  // Applies ?type= and ?tag= from the URL to the list, and keeps chip clicks in-page.
  function apply() {
    const params = new URLSearchParams(location.search);
    const type = params.get('type') ?? '';
    const tag = params.get('tag') ?? '';
    let visible = 0;

    for (const item of document.querySelectorAll<HTMLElement>('.feed .list > li')) {
      const show =
        (!type || item.dataset.type === type) && (!tag || (item.dataset.tags ?? '').split(' ').includes(tag));
      item.hidden = !show;
      if (show) visible++;
    }

    for (const chip of document.querySelectorAll<HTMLAnchorElement>('.feed [data-filter]')) {
      const active = chip.dataset.filter === 'type' ? type : tag;
      const current = chip.dataset.value === active && (chip.dataset.value !== '' || !tag);
      if (current) chip.setAttribute('aria-current', 'true');
      else chip.removeAttribute('aria-current');
    }

    const empty = document.querySelector<HTMLElement>('.feed .empty');
    if (empty) empty.hidden = visible > 0;
  }

  document.querySelector('.feed .filters')?.addEventListener('click', (event) => {
    const chip = (event.target as Element).closest<HTMLAnchorElement>('[data-filter]');
    if (!chip) return;
    event.preventDefault();
    const params = new URLSearchParams(location.search);
    const { filter, value } = chip.dataset;
    if (!filter || !value) {
      params.delete('type');
      params.delete('tag');
    } else if (params.get(filter) === value) {
      params.delete(filter);
    } else {
      params.set(filter, value);
    }
    const query = params.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
    apply();
  });

  apply();
</script>

<style>
  .filters {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.75em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
  }

  .chips a:hover {
    border-color: var(--muted);
  }

  .chips a[aria-current='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .tags {
    font-size: 0.85rem;
  }

  .tags a {
    color: var(--muted);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .list > li {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    gap: 0.25rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .list > li[hidden] {
    display: none;
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    height: fit-content;
    padding-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.3rem;
    font-weight: 600;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .list p {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
  }

  time {
    padding-top: 0.2rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .list > li {
      grid-template-columns: 1fr auto;
    }

    .list > li > div {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
