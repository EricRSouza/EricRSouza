---
/** Card for a project post, with its illustration; used on the home page. */
import { Arrow } from '../react/Icons';
import { ProjectVisual } from '../react/ProjectVisual';
import { ui } from '../i18n';
import { postUrl, type Post } from '../posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = postUrl(post);
---

<article class="project-card">
  {
    post.data.cover && (
      <div class="project-image-link">
        <ProjectVisual kind={post.data.cover} locale={post.lang} />
      </div>
    )
  }
  <div class="project-card-body">
    <p class="tiny-label">{post.data.kicker}</p>
    <h3><a href={href} class="project-card-link">{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <span class="text-link" aria-hidden="true">{ui[post.lang].viewProject}<Arrow /></span>
  </div>
</article>
